{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

"logo": {
"type": "kitty",
"source": "/home/brunofs/Pictures/ff=4.jpg",
"width": 32,
"padding": {
"top": 1,
"right": 4
}
},

"display": {
"separator": " : ",
"color": {
"title": "cyan",
"keys": "magenta"
}
},

"modules": [

"break",
{
"type": "title",
"format": "{user-name-colored}@{host-name-colored}",
},

"break",

{
  "type": "os",
  "key": "󰣇 OS"
},
{
  "type": "kernel",
  "key": "󰒋 Kernel"
},
{
  "type": "packages",
  "key": "󰏖 Packages"
},
{
  "type": "uptime",
  "key": "󰅐 Uptime"
},

"break",

{
  "type": "cpu",
  "key": "󰍛 CPU",
  "format": "i5-1235U (10C/12T) @ 4.40 GHz"
},
{
  "type": "gpu",
  "key": "󰢮 GPU",
  "format": "{name}"
},
{
  "type": "memory",
  "format": "{percentage} {used} / {total} ",
  "key": "󰑭 Memory"
},
{
  "type": "disk",
  "format": "{size-percentage} {size-used} / {size-total}",
  "folders": "/",
  "key": "󰋊 Root"
},

"break",

{
  "type": "wm",
  "key": "󱂬 WM"
},
{
  "type": "terminal",
  "key": "󰆍 Terminal"
},
{
  "type": "terminalfont",
  "key": "󰛖 Font",
  "format": "{name}"
},
{
  "type": "display",
  "key": "󰍹 Display",
  "format": "{inch}p {width}x{height} @ {refresh-rate} Hz"
},
// {
//   "type": "brightness",
//   "key": "󰃠 Brightness"
// },
{
  "type": "pci",
  "key": "󰈀 PCIe"
},
{
  "type": "battery",
  "key": "󰁹 Battery"
},
"break",

]
}
